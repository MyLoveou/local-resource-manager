{
  "name": "local-resource-manager",
  "private": true,
  "version": "0.0.0",
  "description": "本地资源管理器：统一管理图片/视频，元数据自建抓取，内置下载",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter desktop build",
    "start": "pnpm --filter desktop start",
    "release:win": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
    "backend:freeze": "apps/backend/.venv/Scripts/python -m PyInstaller --noconfirm --clean --distpath apps/backend/dist --workpath apps/backend/build apps/backend/packaging/backend.spec",
    "openspec": "openspec",
    "backend:install": "python -m venv apps/backend/.venv && apps/backend/.venv/Scripts/pip install -r apps/backend/requirements.txt",
    "backend:start": "apps/backend/.venv/Scripts/python -m uvicorn app.main:app --app-dir apps/backend --host 127.0.0.1 --port 8000"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.2"
  }
}
